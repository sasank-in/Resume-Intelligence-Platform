# Required
GROQ_API_KEY=your_groq_api_key_here

# Optional
GROQ_MODEL=openai/gpt-oss-120b
ENV=development            # development | production
LOG_LEVEL=INFO
LOG_JSON=false             # true in prod for JSON logs

# Sessions
# Use "redis" in production (required if WEB_CONCURRENCY > 1). "memory" is dev-only.
SESSION_BACKEND=memory     # memory | redis
SESSION_TIMEOUT=3600       # seconds
SESSION_CLEANUP_INTERVAL=300
REDIS_URL=redis://localhost:6379/0

# Error tracking (optional). Leave blank to disable Sentry.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0

# Prometheus metrics on /metrics (optional). Disabled by default.
# When enabled, also set METRICS_BASIC_AUTH=user:pass to require basic auth.
METRICS_ENABLED=false
METRICS_BASIC_AUTH=

# Limits
MAX_FILE_SIZE=10485760
REQUEST_TIMEOUT=60

# Rate limiting (slowapi format)
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_UPLOAD=10/minute
RATE_LIMIT_LLM=30/minute

# CORS — comma-separated origins (leave blank to disable CORS middleware)
CORS_ORIGINS=
